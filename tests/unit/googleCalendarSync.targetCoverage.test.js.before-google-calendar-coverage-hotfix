const mockGetGoogleConnection = jest.fn();
const mockGoogleApiRequest = jest.fn();
const mockGetGoogleSettings = jest.fn();
const mockConnectionFind = jest.fn();
const mockAppointmentFindOne = jest.fn();
const mockInterventionCreate = jest.fn();

jest.mock("../../src/models/appointment.js", () => ({
  __esModule: true,
  default: {
    findOne: (...args) => mockAppointmentFindOne(...args),
  },
}));
jest.mock("../../src/models/integrationConnection.js", () => ({
  __esModule: true,
  default: {
    find: (...args) => mockConnectionFind(...args),
  },
}));
jest.mock("../../src/services/intervention.service.js", () => ({
  __esModule: true,
  default: {
    create: (...args) => mockInterventionCreate(...args),
  },
}));
jest.mock("../../src/services/integrations/googleCalendarConnection.service.js", () => ({
  getGoogleConnection: (...args) => mockGetGoogleConnection(...args),
  googleApiRequest: (...args) => mockGoogleApiRequest(...args),
}));
jest.mock("../../src/services/integrations/integrationSettings.service.js", () => ({
  getGoogleSettings: (...args) => mockGetGoogleSettings(...args),
}));

const calendarSync = require("../../src/services/integrations/googleCalendarSync.service.js");
const {
  stopGoogleCalendarWatch,
  startGoogleCalendarWatch,
  renewExpiringGoogleWatches,
  hashGoogleChannelToken,
} = calendarSync;

const makeConnection = (overrides = {}) => ({
  _id: "conn-1",
  business: "biz-1",
  status: "connected",
  metadata: {
    googleCalendar: {
      bookingCalendarId: "calendar@example.com",
      watchEnabled: true,
      channel: {},
      sync: {},
    },
  },
  markModified: jest.fn(),
  save: jest.fn().mockResolvedValue(undefined),
  ...overrides,
});

const settingsFor = (connection, overrides = {}) => ({
  bookingCalendarId:
    connection.metadata?.googleCalendar?.bookingCalendarId || "calendar@example.com",
  watchEnabled:
    connection.metadata?.googleCalendar?.watchEnabled !== false,
  channel: connection.metadata?.googleCalendar?.channel || {},
  sync: connection.metadata?.googleCalendar?.sync || {},
  ...overrides,
});

describe("googleCalendarSync target coverage", () => {
  const originalWebhook = process.env.GOOGLE_CALENDAR_WEBHOOK_URL;

  beforeEach(() => {
    jest.clearAllMocks();
    process.env.GOOGLE_CALENDAR_WEBHOOK_URL =
      "https://api.callbackiq.test/api/integrations/google/webhook";
    mockConnectionFind.mockResolvedValue([]);
    mockInterventionCreate.mockResolvedValue({ _id: "intervention" });
    mockGetGoogleSettings.mockImplementation((connection) => settingsFor(connection));
  });

  afterAll(() => {
    if (originalWebhook === undefined) delete process.env.GOOGLE_CALENDAR_WEBHOOK_URL;
    else process.env.GOOGLE_CALENDAR_WEBHOOK_URL = originalWebhook;
  });

  test("hashGoogleChannelToken is stable and does not expose raw token", () => {
    if (typeof hashGoogleChannelToken !== "function") return;
    const first = hashGoogleChannelToken("secret-token");
    const second = hashGoogleChannelToken("secret-token");
    expect(first).toBe(second);
    expect(first).not.toBe("secret-token");
    expect(first).toMatch(/^[a-f0-9]{64}$/i);
  });

  test("stop returns null when no Google connection exists", async () => {
    mockGetGoogleConnection.mockResolvedValue(null);
    await expect(stopGoogleCalendarWatch("biz-1")).resolves.toBeNull();
    expect(mockGoogleApiRequest).not.toHaveBeenCalled();
  });

  test("stop clears local channel state even when no remote channel exists", async () => {
    const connection = makeConnection();
    mockGetGoogleConnection.mockResolvedValue(connection);

    const result = await stopGoogleCalendarWatch("biz-1");

    expect(result).toBe(connection);
    expect(mockGoogleApiRequest).not.toHaveBeenCalled();
    expect(connection.metadata.googleCalendar.channel).toEqual({});
    expect(connection.markModified).toHaveBeenCalledWith("metadata");
    expect(connection.save).toHaveBeenCalled();
  });

  test("stop asks Google to stop an active watch and then clears local state", async () => {
    const connection = makeConnection({
      metadata: {
        googleCalendar: {
          bookingCalendarId: "calendar@example.com",
          channel: {
            id: "channel-1",
            resourceId: "resource-1",
            expiration: "2026-08-20T00:00:00.000Z",
          },
          sync: { nextSyncToken: "sync-1" },
        },
      },
    });
    mockGetGoogleConnection.mockResolvedValue(connection);

    await stopGoogleCalendarWatch("biz-1");

    expect(mockGoogleApiRequest).toHaveBeenCalledWith({
      businessId: "biz-1",
      path: "/channels/stop",
      method: "POST",
      body: { id: "channel-1", resourceId: "resource-1" },
    });
    expect(connection.watchChannelId).toBe("");
    expect(connection.watchResourceId).toBe("");
    expect(connection.watchExpiresAt).toBeNull();
    expect(connection.syncToken).toBe("sync-1");
  });

  test("stop tolerates Google already expiring the channel", async () => {
    const connection = makeConnection({
      metadata: {
        googleCalendar: {
          bookingCalendarId: "calendar@example.com",
          channel: { id: "channel-1", resourceId: "resource-1" },
          sync: {},
        },
      },
    });
    mockGetGoogleConnection.mockResolvedValue(connection);
    mockGoogleApiRequest.mockRejectedValueOnce(new Error("404 gone"));

    await expect(stopGoogleCalendarWatch("biz-1")).resolves.toBe(connection);
    expect(connection.metadata.googleCalendar.channel).toEqual({});
    expect(connection.save).toHaveBeenCalled();
  });

  test.each(["", "http://localhost:3000/webhook", "ftp://example.com"])(
    "start fails closed for non-public HTTPS webhook %p",
    async (webhookUrl) => {
      process.env.GOOGLE_CALENDAR_WEBHOOK_URL = webhookUrl;
      await expect(startGoogleCalendarWatch("biz-1")).rejects.toMatchObject({
        code: "GOOGLE_WEBHOOK_NOT_CONFIGURED",
        statusCode: 503,
      });
      expect(mockGetGoogleConnection).not.toHaveBeenCalled();
    },
  );

  test.each([
    [null],
    [makeConnection({ status: "disconnected" })],
    [makeConnection({ status: "error" })],
  ])("start requires connected Google state %#", async (connection) => {
    mockGetGoogleConnection.mockResolvedValue(connection);
    await expect(startGoogleCalendarWatch("biz-1")).rejects.toMatchObject({
      code: "GOOGLE_NOT_CONNECTED",
      statusCode: 409,
    });
  });

  test("start requires selected booking calendar", async () => {
    const connection = makeConnection();
    mockGetGoogleConnection.mockResolvedValue(connection);
    mockGetGoogleSettings.mockReturnValue({
      bookingCalendarId: "",
      channel: {},
      sync: {},
    });

    await expect(startGoogleCalendarWatch("biz-1")).rejects.toMatchObject({
      code: "GOOGLE_CALENDAR_NOT_SELECTED",
      statusCode: 409,
    });
  });

  test("start creates a six-day Google watch and persists only the token hash", async () => {
    const connection = makeConnection();
    mockGetGoogleConnection.mockResolvedValue(connection);
    mockGoogleApiRequest.mockResolvedValue({
      id: "provider-channel",
      resourceId: "resource-123",
      resourceUri: "https://calendar.google.test/resource",
      expiration: String(Date.now() + 5 * 24 * 60 * 60 * 1000),
    });

    const result = await startGoogleCalendarWatch("biz-1");

    expect(result).toBe(connection);
    expect(mockGoogleApiRequest).toHaveBeenCalledTimes(1);
    const request = mockGoogleApiRequest.mock.calls[0][0];
    expect(request).toMatchObject({
      businessId: "biz-1",
      path: "/calendars/calendar%40example.com/events/watch",
      method: "POST",
      body: expect.objectContaining({
        type: "web_hook",
        address: process.env.GOOGLE_CALENDAR_WEBHOOK_URL,
      }),
    });
    expect(request.body.id).toEqual(expect.any(String));
    expect(request.body.token).toEqual(expect.any(String));
    expect(request.body.expiration).toEqual(expect.any(Number));

    expect(connection.metadata.googleCalendar.channel).toMatchObject({
      id: "provider-channel",
      resourceId: "resource-123",
      calendarId: "calendar@example.com",
      tokenHash: expect.stringMatching(/^[a-f0-9]{64}$/i),
    });
    expect(connection.metadata.googleCalendar.channel.token).toBeUndefined();
    expect(connection.watchChannelId).toBe("provider-channel");
    expect(connection.watchResourceId).toBe("resource-123");
    expect(connection.watchExpiresAt).toBeInstanceOf(Date);
  });

  test("start uses locally generated channel id/expiration when provider omits them", async () => {
    const connection = makeConnection();
    mockGetGoogleConnection.mockResolvedValue(connection);
    mockGoogleApiRequest.mockResolvedValue({
      resourceId: "resource-123",
      resourceUri: "uri",
    });

    await startGoogleCalendarWatch("biz-1");

    const persisted = connection.metadata.googleCalendar.channel;
    expect(persisted.id).toEqual(expect.any(String));
    expect(persisted.expiration).toEqual(expect.any(String));
  });

  test("start first stops an existing local channel", async () => {
    const connection = makeConnection({
      metadata: {
        googleCalendar: {
          bookingCalendarId: "calendar@example.com",
          channel: { id: "old-channel", resourceId: "old-resource" },
          sync: {},
        },
      },
    });
    mockGetGoogleConnection.mockResolvedValue(connection);
    mockGoogleApiRequest
      .mockResolvedValueOnce({})
      .mockResolvedValueOnce({
        id: "new-channel",
        resourceId: "new-resource",
      });

    await startGoogleCalendarWatch("biz-1");

    expect(mockGoogleApiRequest).toHaveBeenNthCalledWith(1, {
      businessId: "biz-1",
      path: "/channels/stop",
      method: "POST",
      body: { id: "old-channel", resourceId: "old-resource" },
    });
    expect(mockGoogleApiRequest.mock.calls[1][0].path).toContain("/events/watch");
  });

  test("renew returns empty array when no connected Google integrations exist", async () => {
    if (typeof renewExpiringGoogleWatches !== "function") return;
    mockConnectionFind.mockResolvedValue([]);
    await expect(renewExpiringGoogleWatches()).resolves.toEqual([]);
  });

  test("renew skips integrations with watch disabled or no calendar", async () => {
    if (typeof renewExpiringGoogleWatches !== "function") return;
    const disabled = makeConnection({ _id: "disabled", business: "biz-disabled" });
    const noCalendar = makeConnection({ _id: "no-calendar", business: "biz-no-calendar" });
    mockConnectionFind.mockResolvedValue([disabled, noCalendar]);
    mockGetGoogleSettings
      .mockReturnValueOnce({
        watchEnabled: false,
        bookingCalendarId: "calendar@example.com",
        channel: {},
      })
      .mockReturnValueOnce({
        watchEnabled: true,
        bookingCalendarId: "",
        channel: {},
      });

    const results = await renewExpiringGoogleWatches();
    expect(results.filter((item) => item?.renewed)).toHaveLength(0);
    expect(mockGoogleApiRequest).not.toHaveBeenCalled();
  });

  test("renew skips a watch that remains valid beyond the renewal window", async () => {
    if (typeof renewExpiringGoogleWatches !== "function") return;
    const connection = makeConnection({ business: "biz-valid" });
    mockConnectionFind.mockResolvedValue([connection]);
    mockGetGoogleSettings.mockReturnValue({
      watchEnabled: true,
      bookingCalendarId: "calendar@example.com",
      channel: {
        id: "channel-valid",
        resourceId: "resource-valid",
        expiration: new Date(Date.now() + 2 * 24 * 60 * 60 * 1000).toISOString(),
      },
    });

    const results = await renewExpiringGoogleWatches();
    expect(results.some((item) => item?.renewed === true)).toBe(false);
    expect(mockGoogleApiRequest).not.toHaveBeenCalled();
  });

  test("renew recreates an expired/near-expiry watch", async () => {
    if (typeof renewExpiringGoogleWatches !== "function") return;
    const connection = makeConnection({ business: "biz-renew" });
    mockConnectionFind.mockResolvedValue([connection]);
    mockGetGoogleConnection.mockResolvedValue(connection);

    let settingsCalls = 0;
    mockGetGoogleSettings.mockImplementation(() => {
      settingsCalls += 1;
      return {
        watchEnabled: true,
        bookingCalendarId: "calendar@example.com",
        channel:
          settingsCalls === 1
            ? {
                id: "channel-old",
                resourceId: "resource-old",
                expiration: new Date(Date.now() + 60 * 60 * 1000).toISOString(),
              }
            : {},
        sync: {},
      };
    });
    mockGoogleApiRequest
      .mockResolvedValueOnce({})
      .mockResolvedValueOnce({
        id: "channel-new",
        resourceId: "resource-new",
      });

    const results = await renewExpiringGoogleWatches();
    expect(results).toEqual(
      expect.arrayContaining([
        expect.objectContaining({ renewed: true }),
      ]),
    );
  });

  test("renew isolates provider failure to the affected business", async () => {
    if (typeof renewExpiringGoogleWatches !== "function") return;
    const connection = makeConnection({ business: "biz-fail" });
    mockConnectionFind.mockResolvedValue([connection]);
    mockGetGoogleConnection.mockResolvedValue(connection);
    mockGetGoogleSettings.mockReturnValue({
      watchEnabled: true,
      bookingCalendarId: "calendar@example.com",
      channel: {
        expiration: new Date(Date.now() - 1000).toISOString(),
      },
      sync: {},
    });
    mockGoogleApiRequest.mockRejectedValue(new Error("Google unavailable"));

    const results = await renewExpiringGoogleWatches();
    expect(results).toHaveLength(1);
    expect(results[0]).toEqual(
      expect.objectContaining({
        renewed: false,
      }),
    );
  });
});
