# Harness target. The script automatically loads ../.env from callbackiq_api
# first, then overlays this optional harness .env. Shell variables always win.
CALLBACKIQ_API_BASE_URL=http://127.0.0.1:3000
CALLBACKIQ_UI_BASE_URL=http://127.0.0.1:3001

# Existing owner accounts only. No registration is performed.
LOGIN_ATLANTA=
PASSWORD_ATLANTA=
LOGIN_BIRMINGHAM=
PASSWORD_BIRMINGHAM=

# Alternative auth if you already have a valid session credential.
COOKIE_ATLANTA=
COOKIE_BIRMINGHAM=
BEARER_ATLANTA=
BEARER_BIRMINGHAM=

# Required before load-testing a non-local environment that you own.
ALLOW_REMOTE_LOAD_TEST=no

# High-volume synthetic app/database activity.
ALLOW_SYNTHETIC_WRITES=no
LOAD_CONCURRENCY=20
LOAD_FLOWS_PER_BUSINESS=100
REQUEST_TIMEOUT_MS=15000

# Fake marketing-source/tracking-number attribution fixtures.
# These create temporary MongoDB records through the API repo's Mongoose models.
# No Twilio number purchase/provisioning endpoint is called.
ALLOW_ATTRIBUTION_FIXTURES=no
ATTRIBUTION_NUMBERS_PER_BUSINESS=3
KEEP_ATTRIBUTION_FIXTURES=no
STRICT_ATTRIBUTION_PROPAGATION=no

# If the API validates Twilio signatures against ngrok/public URL while the
# harness sends HTTP locally, set this to the exact public webhook origin.
TWILIO_WEBHOOK_SIGNATURE_BASE_URL=

# Provider-integrated checks are intentionally sampled/capped.
# Turning this on can send real SMS, invoke AI, create calendar events,
# reminders, etc. depending on current business settings.
ALLOW_PROVIDER_SIDE_EFFECTS=no
AI_SAMPLES_PER_BUSINESS=2
PROVIDER_WEBHOOK_FLOWS_PER_BUSINESS=2

# Normally inherited automatically from callbackiq_api/.env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Real phone-call smoke: separate existing verified/Twilio caller ID only.
ALLOW_LIVE_CALLS=no
LIVE_CALLER_ID=
MAX_LIVE_CALLS_TOTAL=2

# Optional real SMS smoke: separate SMS-capable test/customer number only.
ALLOW_LIVE_SMS=no
LIVE_SMS_FROM=
MAX_LIVE_SMS_TOTAL=4

# UI smoke (requires Playwright).
UI_HEADFUL=no

# Reporting.
RUN_TAG=
REPORT_DIR=./reports
