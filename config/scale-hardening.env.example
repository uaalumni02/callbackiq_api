# CALLBACKIQ_SCALE_HARDENING_V1
# Apply to production/staging after sizing against your Atlas/Redis/provider tiers.

# Run HTTP/API and workers as separate processes when scaling horizontally.
PROCESS_ROLE=api
API_INSTANCE_COUNT=2

# Shared Redis is required for multi-instance Socket.IO and recommended for
# distributed analytics/dashboard caching.
REDIS_URL=
SOCKET_REDIS_REQUIRED=true
SCALE_CACHE_ENABLED=true
SCALE_CACHE_REDIS_URL=
SCALE_CACHE_NAMESPACE=callbackiq:scale:v1
SCALE_CACHE_MEMORY_MAX_ENTRIES=5000

DASHBOARD_CACHE_TTL_MS=5000
DASHBOARD_CACHE_STALE_MS=20000
OWNER_DASHBOARD_CACHE_TTL_MS=5000
OWNER_DASHBOARD_CACHE_STALE_MS=20000
ANALYTICS_SUMMARY_CACHE_TTL_MS=10000
ANALYTICS_OVERVIEW_CACHE_TTL_MS=15000
ANALYTICS_CACHE_TTL_MS=15000
ANALYTICS_CACHE_STALE_MS=60000

# Connection budget = sum(maxPoolSize across API and worker processes).
# Tune these against the MongoDB Atlas tier before increasing instance counts.
MONGO_MAX_POOL_SIZE=40
MONGO_MIN_POOL_SIZE=5
MONGO_MAX_CONNECTING=8
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_WAIT_QUEUE_TIMEOUT_MS=5000
MONGO_MAX_IDLE_TIME_MS=30000

# Keep-alive should generally be longer than the upstream proxy/LB idle timeout.
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_MAX_REQUESTS_PER_SOCKET=1000

# Put these on PROCESS_ROLE=worker-sms instances, not every API instance.
# Increase gradually while watching Twilio/OpenAI quotas and queue latency.
SMS_PROCESSING_WORKER_ENABLED=true
SMS_PROCESSING_INTERVAL_MS=500
SMS_PROCESSING_BUSY_DELAY_MS=25
SMS_PROCESSING_BATCH_SIZE=100
SMS_PROCESSING_CONCURRENCY=10
SMS_PROCESSING_LEASE_MS=60000
SMS_PROCESSING_MAX_ATTEMPTS=5
