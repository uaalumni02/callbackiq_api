# CallBackIQ production-hardening additions
# Canonical names. Legacy MONGO_URL/API_PUBLIC_URL remain accepted as fallbacks.
MONGODB_URI=
PUBLIC_API_URL=
CLIENT_URL=

# Express proxy trust. On Render/one trusted reverse proxy, 1 is typical.
TRUST_PROXY=1

# Use api for HTTP replicas. Run build/worker.js separately with worker roles.
PROCESS_ROLE=api
API_INSTANCE_COUNT=1

# Required automatically if API_INSTANCE_COUNT > 1 in production/staging.
SOCKET_REDIS_REQUIRED=false
SOCKET_REDIS_URL=

# Production never returns the cookie JWT in JSON. Keep false/empty.
AUTH_RESPONSE_TOKEN_ENABLED=false

# Distributed public-auth throttling is automatically enabled in prod/staging.
DISTRIBUTED_AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_FAIL_CLOSED=true

# Structured request/process metrics log.
RUNTIME_METRICS_LOG_ENABLED=true
RUNTIME_METRICS_LOG_INTERVAL_MS=60000

# Worker graceful-stop window.
WORKER_DRAIN_GRACE_MS=3000
A2P_RECONCILIATION_LEASE_MS=300000

# HTTP performance budget defaults.
PERF_BUDGET_P95_MS=500
PERF_BUDGET_P99_MS=1000
