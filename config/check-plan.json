{
  "repository": "callbackiq_api",
  "gates": [
    {
      "name": "Structure and contracts",
      "steps": [
        "lint",
        "audit:imports",
        "config:inventory",
        "contracts:check",
        "contracts:state-writers",
        "maintainability:complexity",
        "maintainability:remediation",
        "maintainability:check",
        "maintainability:boundaries",
        "maintainability:release9",
        "maintainability:architecture",
        "architecture:invariants"
      ]
    },
    {
      "name": "Runtime and data contracts",
      "steps": [
        "verify:index-manifest",
        "release:gate"
      ]
    },
    {
      "name": "Behavior and coverage",
      "steps": [
        "test:coverage",
        "verify:coverage-ratchet",
        "verify:diff-coverage",
        "test:hardening",
        "test:replica-set",
        "test:production-certification",
        "test:voice-concurrency"
      ]
    },
    {
      "name": "Build",
      "steps": [
        "build:certification"
      ]
    },
    {
      "name": "Security",
      "steps": [
        "audit:repository-hygiene",
        "audit:source-security",
        "audit:runtime-security"
      ]
    }
  ],
  "advisory": [
    "coverage:risk-report",
    "benchmark:customer-truth"
  ]
}
