    "verify:phase2:internal": "node scripts/verify-internal-appointment-e2e.js",
    "verify:phase3:google": "node scripts/verify-google-calendar-e2e.js",
    "verify:phase8:jobber": "node scripts/verify-jobber-e2e.js",
    "ensure:phase0:indexes": "node scripts/ensure-phase0-provider-indexes.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "CallBackIQ API",
  "dependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/plugin-syntax-object-rest-spread": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/register": "^7.29.7",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "mongoose": "^9.7.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "openai": "^6.42.0",
    "resend": "^6.17.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.1",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2"
