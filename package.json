{
  "name": "callbackiq_api",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "jest --runInBand",
    "test:watch": "jest --watch --runInBand",
    "test:phase0": "jest tests/unit/businessFeatures.test.js tests/unit/twilioEventKey.test.js tests/unit/contactPreference.service.test.js tests/unit/twilioWebhookEvent.service.test.js tests/integration/twilioWebhookIdempotency.test.js tests/integration/twilioOptOut.test.js tests/integration/businessFeatures.test.js tests/integration/providerUniqueIndexes.test.js tests/routes/twilio.routes.test.js tests/routes/business.routes.test.js tests/routes/dashboard.routes.test.js tests/routes/alert.routes.test.js --runInBand",
    "test:phase1": "jest tests/routes/businessConfiguration.routes.test.js tests/services/bookingEligibility.service.test.js --runInBand",
    "test:phase2": "jest tests/completion/phase0-2.contract.test.js tests/unit/timezone.service.test.js tests/unit/appointmentPolicy.service.test.js tests/unit/appointment.service.test.js tests/unit/internalScheduling.provider.test.js tests/unit/slotGenerator.service.test.js tests/integration/appointmentEngine.test.js --runInBand",
    "test:phase0-2:completion": "npm run verify:phase0-2:structure && npm run test:phase0 && npm run test:phase1 && npm run test:phase2",
    "verify:phase0-2:structure": "node scripts/verify-phase0-2-structure.js",
    "test:phase2-8": "jest tests/unit/timezone.service.test.js tests/unit/aiReplyBookingSafety.test.js tests/integration/appointmentEngine.test.js --runInBand",
    "test:phase4": "jest tests/unit/aiReplyBookingSafety.test.js tests/integration/aiBookingConversationMatrix.completion.test.js --runInBand",
    "test:phase7": "jest tests/controllers/intervention.completion.test.js tests/integration/interventionSocketDelivery.completion.test.js tests/unit/phase2_8.controllers.full.test.js --runInBand",
    "test:phase4-7:completion": "npm run test:phase4 && npm run test:phase7",
    "test:validators": "jest tests/validators --runInBand",
    "test:routes": "jest tests/routes --runInBand",
    "test:auth": "jest tests/validators/auth.test.js --runInBand",
    "test:business": "jest tests/validators/business.test.js --runInBand",
    "test:lead": "jest tests/validators/lead.test.js --runInBand",
    "test:conversation": "jest tests/validators/conversation.test.js --runInBand",
    "test:message": "jest tests/validators/message.test.js --runInBand",
    "test:calllog": "jest tests/validators/callLog.test.js --runInBand",
    "test:integrations": "jest tests/unit/integrationSettings.test.js tests/unit/googleCalendarProvider.test.js tests/unit/integrationWebhookSignature.test.js --runInBand",
    "start:dev": "nodemon --watch src --ext js --exec babel-node src/server.js",
    "build": "babel src -d build --delete-dir-on-start",
    "start": "node build/server.js",
    "validate:env": "node scripts/validate-environment.js",
    "smoke:test": "node scripts/smoke-test.js",
    "backup:db": "bash scripts/backup-mongodb.sh",
    "restore:verify": "node scripts/verify-restoration.js",
    "seed:phase2-8": "node scripts/seed-phase2-8-workflows.js",
    "audit:phase2-8": "node scripts/audit-phase2-8-readiness.js",
    "test:phase0-8:completion": "jest tests/unit/postalCodeDistance.service.test.js tests/unit/appointmentPolicy.completion.test.js tests/unit/revenueRecovery.completion.test.js tests/controllers/intervention.completion.test.js --runInBand",
    "verify:phase2:internal": "node scripts/verify-internal-appointment-e2e.js",
    "verify:phase3:google": "node scripts/verify-google-calendar-e2e.js",
    "verify:phase8:jobber": "node scripts/verify-jobber-e2e.js",
    "ensure:phase0:indexes": "node scripts/ensure-phase0-provider-indexes.js",
    "verify:phase9:structure": "node scripts/verify-phase9-structure.js",
    "test:phase9": "jest tests/unit/conversationRelay.server.test.js tests/unit/sendConfirmationSms.tool.test.js tests/unit/voiceAgent.service.test.js tests/unit/voiceRouting.service.test.js tests/unit/voiceSession.model.test.js tests/unit/voiceSessionFallback.service.test.js tests/unit/voiceSettings.controller.test.js tests/unit/voiceWebhook.controller.test.js tests/unit/voiceBookingStateMachineReuse.test.js tests/unit/safetyAssessmentService.voiceCompatibility.test.js --runInBand",
    "certify:phase9": "npm run verify:phase9:structure && npm run test:voice-hardening && npm run test:phase0-8:completion && npm run test:phase9 && npm run test:phase9:unit && npm run test:phase9:completion && npm run build",
    "test:phase9:unit": "jest tests/unit/conversationRelay.server.test.js tests/unit/createAppointment.tool.test.js tests/unit/voiceFailure.service.test.js tests/unit/voiceRouting.service.test.js tests/unit/voiceRoutingPolicy.service.test.js tests/unit/voiceSettings.controller.test.js tests/unit/voiceWebhook.controller.test.js --runInBand",
    "test:phase9:completion": "jest tests/completion/phase9.voice.completion.test.js --runInBand",
    "verify:phase9:live": "node scripts/verify-phase9-live.js",
    "migrate:phase9:disable-recording": "node --env-file=.env scripts/disable-legacy-voice-recording.js",
    "test:communication-safety": "node scripts/verify-communication-safety-structure.js && jest --runInBand tests/unit/communicationSafety.aiCounter.test.js tests/unit/communicationSafety.smsPolicy.test.js tests/unit/communicationSafety.usageBudgets.test.js tests/unit/communicationSafety.rateLimit.test.js tests/unit/communicationSafety.voiceCapacity.test.js tests/unit/communicationSafety.voiceRelayLimits.test.js tests/unit/communicationSafety.safeLogger.test.js tests/unit/automation.service.test.js tests/routes/twilio.routes.test.js tests/routes/agent.routes.test.js tests/unit/conversationRelay.server.test.js",
    "test:voice-hardening": "node --test hardening-tests/*.test.mjs",
    "voice:reap-stale": "node --env-file=.env scripts/reap-stale-voice-sessions.mjs",
    "voice:redact-transcripts": "node --env-file=.env scripts/redact-expired-voice-transcripts.mjs",
    "voice:sweep-capacity": "node --env-file=.env scripts/sweep-expired-voice-capacity.mjs",
    "voice:migrate-phones": "node --env-file=.env scripts/normalize-business-phone-numbers.mjs",
    "voice:migrate-phones:apply": "node --env-file=.env scripts/normalize-business-phone-numbers.mjs --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "CallBackIQ API",
  "dependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/node": "^7.29.7",
    "@babel/plugin-syntax-object-rest-spread": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/register": "^7.29.7",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "googleapis": "^173.0.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "mongoose": "^9.7.0",
    "nodemailer": "^9.0.3",
    "nodemon": "^3.1.14",
    "openai": "^6.42.0",
    "resend": "^6.17.1",
    "socket.io": "^4.8.3",
    "stripe": "^22.2.1",
    "twilio": "^6.0.2",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/tools/api_overlay/",
      "<rootDir>/.callbackiq-phase9-backup/",
      "<rootDir>/.callbackiq-backups/",
      "<rootDir>/hardening-tests/",
      "<rootDir>/tools/",
      "<rootDir>/.callbackiq-voice-hardening-backups/",
      "<rootDir>/callbackiq[^/]*_update/",
      "<rootDir>/CallBackIQ[^/]*(?:Update|Bundle)/",
      "<rootDir>/.callbackiq-fix-backups/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/.callbackiq-phase9-backup/",
      "<rootDir>/.callbackiq-backups/",
      "<rootDir>/.callbackiq-fix-backups/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.callbackiq-phase9-backup/",
      "<rootDir>/.callbackiq-backups/",
      "<rootDir>/.callbackiq-fix-backups/"
    ],
    "watchman": false
  }
}
