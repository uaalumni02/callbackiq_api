    "verify:phase0-2:structure": "node scripts/verify-phase0-2-structure.js",
    "test:phase2-8": "jest tests/unit/timezone.service.test.js tests/unit/aiReplyBookingSafety.test.js tests/integration/appointmentEngine.test.js --runInBand",
