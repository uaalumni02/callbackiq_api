# Local development only. Generate JWT_SECRET before starting.
NODE_ENV=development
APP_ENV=development
PROCESS_ROLE=api
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/meekcall_local?replicaSet=rs0
CLIENT_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3001
JWT_SECRET=
AUTH_RESPONSE_TOKEN_ENABLED=false
# Provider credentials are optional for local UI development and offline tests.
# Use isolated test accounts when enabling provider calls; see README.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
OPENAI_API_KEY=
INTEGRATION_ENCRYPTION_KEY=

# Optional external error tracking and dead-job notifications. No customer content.
SENTRY_DSN=
OPS_ALERT_WEBHOOK_URL=

# Ceiling for idle SMS and webhook-work polling; busy polling is unchanged.
WORKER_IDLE_POLL_MAX_MS=3000

# Explicit capabilities. Production preflight requires each enabled provider configuration.
MEEKCALL_ENABLED_CAPABILITIES=signup,billing,sms,voice,google,staff_notifications
# Signup security and phone verification. Configure the matching public frontend site key.
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TWILIO_VERIFY_SERVICE_SID=
# PRO only. Use a restricted Stripe Portal configuration with subscription creation/quantity changes off.
STRIPE_PRO_PRICE_ID=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
# Authenticated mail for verification, reset, and staff delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Alternative mail transport when SMTP_HOST is absent.
GMAIL_ADDRESS=
GMAIL_PASSWORD=
# Tenant A2P registration requires this parent profile and authenticated event stream.
TWILIO_PRIMARY_CUSTOMER_PROFILE_SID=
A2P_NOTIFICATION_EMAIL=
A2P_EVENT_STREAM_USERNAME=
A2P_EVENT_STREAM_PASSWORD=
# Google OAuth. Keep encryption/state secrets stable across API and worker releases.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
OAUTH_STATE_SECRET=
GOOGLE_CALENDAR_WEBHOOK_URL=
# Public voice host must run PROCESS_ROLE=voice (or an intentional all process).
VOICE_WEBSOCKET_PUBLIC_URL=
VOICE_HTTP_PUBLIC_URL=
# Shared namespaced Redis for production workers and Socket.IO fan-out.
REDIS_URL=
SOCKET_REDIS_URL=
SOCKET_REDIS_CHANNEL_PREFIX=meekcall-local
SCALE_CACHE_NAMESPACE=meekcall-local

# Operator circuit breaker. true stops customer AI, voice reservations and SMS dispatch.
PILOT_PROVIDER_DISPATCH_PAUSED=false
# Server-owned pilot budget ceilings; numeric preflight rejects values above the plan.
PILOT_VOICE_MINUTES_DAY=30
PILOT_VOICE_MINUTES_MONTH=300
PILOT_FLEET_VOICE_MINUTES_DAY=300
PILOT_FLEET_VOICE_MINUTES_MONTH=3000
PILOT_SMS_SEGMENTS_DAY=300
PILOT_SMS_SEGMENTS_MONTH=3000
PILOT_FLEET_SMS_SEGMENTS_DAY=1500
PILOT_FLEET_SMS_SEGMENTS_MONTH=15000
PILOT_AI_REQUESTS_DAY=100
PILOT_AI_REQUESTS_MONTH=1000
PILOT_FLEET_AI_REQUESTS_DAY=500
PILOT_FLEET_AI_REQUESTS_MONTH=5000
PILOT_AI_MAX_OUTPUT_TOKENS=700

# Uncertain Checkout creation must reconcile before Stripe may prune its idempotency key.
PILOT_CHECKOUT_RETRY_WINDOW_MS=72000000

# Billing inventory must be complete before any new Checkout is issued.
PILOT_STRIPE_SUBSCRIPTION_SCAN_PAGES=10

# Final writes always bypass this preview cache; incomplete event pagination blocks booking.
PILOT_GOOGLE_EVENT_SCAN_PAGES=10
PILOT_GOOGLE_AVAILABILITY_CACHE_MS=45000

# Applies to Google OAuth, refresh, calendar calls, response bodies and revocation.
PILOT_GOOGLE_REQUEST_TIMEOUT_MS=10000

# Durable Google revocation retries run on worker-maintenance or the generic worker.
PILOT_GOOGLE_DISCONNECT_POLL_MS=30000

# Fenced staff delivery claims, safe retry delay, and saved-settings test cooldown (ms).
PILOT_NOTIFICATION_LEASE_MS=120000
PILOT_NOTIFICATION_RETRY_MS=60000
PILOT_NOTIFICATION_TEST_COOLDOWN_MS=60000

# Maximum materialized alerts per leased SMS polling partition.
PILOT_STAFF_SMS_PAGE_SIZE=100

# Minimal financial references only; no homeowner/contact content. Confirm legal retention with counsel.
PILOT_BILLING_RETENTION_DAYS=2557
# Anonymous erasure completion counts; never preserve tenant identity in this receipt.
PILOT_ERASURE_RECEIPT_RETENTION_DAYS=90

# Scheduled privacy work: bounded batches, distributed lease and observable heartbeat.
PILOT_PRIVACY_SWEEP_MS=60000
PILOT_PRIVACY_LEASE_MS=120000
PILOT_PRIVACY_SWEEP_LIMIT=100
PILOT_DELETION_SWEEP_LIMIT=2

# Durable Google disconnect claim, backoff and token-free receipt expiry.
PILOT_GOOGLE_DISCONNECT_LEASE_MS=60000
PILOT_GOOGLE_DISCONNECT_RETRY_MS=30000
PILOT_GOOGLE_DISCONNECT_MAX_RETRY_MS=3600000
PILOT_GOOGLE_DISCONNECT_RECEIPT_DAYS=90
# Automatically applied by the leased privacy worker.
VOICE_STALE_SESSION_MINUTES=15
VOICE_TRANSCRIPT_RETENTION_DAYS=30

# Required when staff_notifications is enabled: both urgent channels and approval notices must run.
STAFF_NOTIFICATION_EMAIL_ENABLED=true
STAFF_NOTIFICATION_SMS_ENABLED=true
STAFF_APPROVAL_SMS_ENABLED=true

# Maximum secondary numbers reconciled before a deletion retries the remaining batch.
PILOT_DELETION_NUMBER_BATCH=10

# Expire operational budget records; explicit tenant erasure removes tenant ledgers sooner.
PILOT_PROVIDER_BUDGET_RETENTION_DAYS=100
